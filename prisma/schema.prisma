// ─── EXISTING MODELS ─────────────────────────────────────────────────────────

model School {
  id               String                 @id
  name             String
  slug             String                 @unique
  legalName        String?
  displayName      String?
  shortName        String?
  emailFromName    String?
  primaryColor     String                 @default("#2563eb")
  contactEmail     String?
  phone            String?
  address          String?
  logoUrl          String?
  onboardingStatus SchoolOnboardingStatus @default(PENDING_SETUP)
  setupStep        String?
  setupCompletedAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  admins                         Admin[]
  students                       Student[]
  teachers                       Teacher[]
  parents                        Parent[]
  grades                         Grade[]
  classes                        Class[]
  subjects                       Subject[]
  lessons                        Lesson[]
  exams                          Exam[]
  assignments                    Assignment[]
  homeworkSubmissions            HomeworkSubmission[]
  results                        Result[]
  attendances                    Attendance[]
  attendanceAuditLogs            AttendanceAuditLog[]
  events                         Event[]
  announcements                  Announcement[]
  caConfigs                      CAConfig[]
  caBuckets                      CABucket[]
  caActivities                   CAActivity[]
  caActivityScores               CAActivityScore[]
  caAuditLogs                    CAAuditLog[]
  continuousAssessments          ContinuousAssessment[]
  reportPublications             ReportCardPublication[]
  examEntryWindows               ExamEntryWindow[]
  syllabi                        Syllabus[]
  syllabusTopicProgress          SyllabusTopicProgress[]
  feeStructures                  FeeStructure[]
  studentBills                   StudentBill[]
  payments                       Payment[]
  paymentReversals               PaymentReversal[]
  discounts                      Discount[]
  financeQueries                 FinanceQuery[]
  receiptCounters                ReceiptCounter[]
  financeAuditLogs               FinanceAuditLog[]
  invites                        SchoolInvite[]
  waitlistEntries                WaitlistEntry[]
  onboardingAuditLogs            OnboardingAuditLog[]
  financeJobs                    FinanceJob[]
  paymentWebhookEvents           PaymentWebhookEvent[]
  parentNotifications            ParentNotification[]
  parentActivityEvents           ParentActivityEvent[]
  notificationSettings           SchoolNotificationSetting?
  accountabilitySettings         TeacherAccountabilitySetting?
  teacherObligations             TeacherObligation[]
  teacherReminders               TeacherReminder[]
  teacherEscalations             TeacherEscalation[]
  teacherCorrections             TeacherCorrectionRequest[]
  teacherAccountabilityAuditLogs TeacherAccountabilityAuditLog[]
  parentPreferences              ParentNotificationPreference[]
  parentDeliveryLogs             ParentNotificationDeliveryLog[]
}

model Admin {
  id       String @id
  username String @unique

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Student {
  id        String   @id
  username  String   @unique
  name      String
  surname   String
  email     String?
  phone     String?
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime @default(now())

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id])
  classId  Int
  class    Class  @relation(fields: [classId], references: [id])
  gradeId  Int
  grade    Grade  @relation(fields: [gradeId], references: [id])

  attendances           Attendance[]
  attendanceAuditLogs   AttendanceAuditLog[]
  results               Result[]
  continuousAssessments ContinuousAssessment[]
  caActivityScores      CAActivityScore[]
  bills                 StudentBill[]
  homeworkSubmissions   HomeworkSubmission[]
  parentNotifications   ParentNotification[]
  parentActivityEvents  ParentActivityEvent[]
  financeQueries        FinanceQuery[]

  @@index([schoolId])
  @@index([schoolId, classId])
  @@index([parentId])
  @@index([schoolId, parentId])
  @@index([schoolId, createdAt])
}

model Teacher {
  id         String   @id
  username   String   @unique
  name       String
  surname    String
  email      String?
  phone      String?
  address    String
  img        String?
  bloodType  String
  sex        UserSex
  createdAt  DateTime @default(now())
  maxClasses Int      @default(5)

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  subjects Subject[]
  lessons  Lesson[]
  classes  Class[]   @relation("ClassTeacher")

  continuousAssessments     ContinuousAssessment[]
  caBuckets                 CABucket[]
  caActivities              CAActivity[]
  caActivityScores          CAActivityScore[]
  checkedHomework           HomeworkSubmission[]            @relation("HomeworkCheckedBy")
  parentActivityEvents      ParentActivityEvent[]
  syllabusTopicProgress     SyllabusTopicProgress[]
  accountabilityObligations TeacherObligation[]
  accountabilityReminders   TeacherReminder[]
  accountabilityEscalations TeacherEscalation[]
  correctionRequests        TeacherCorrectionRequest[]
  accountabilityAuditLogs   TeacherAccountabilityAuditLog[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model Parent {
  id        String   @id
  username  String   @unique
  name      String
  surname   String
  email     String?
  phone     String?
  address   String
  createdAt DateTime @default(now())

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  students               Student[]
  notifications          ParentNotification[]
  activityEvents         ParentActivityEvent[]
  notificationPreference ParentNotificationPreference?
  notificationDeliveries ParentNotificationDeliveryLog[]
  financeQueries         FinanceQuery[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
}

model SchoolNotificationSetting {
  id                     String               @id @default(cuid())
  timezone               String               @default("Africa/Accra")
  openingTime            String               @default("07:30")
  closingTime            String               @default("15:00")
  summaryCadence         ParentSummaryCadence @default(WEEKLY)
  dailySummarySendTime   String               @default("15:15")
  weeklySummarySendDay   String               @default("FRIDAY")
  weeklySummarySendTime  String               @default("15:15")
  activeDays             String[]             @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  emailEnabled           Boolean              @default(true)
  smsEnabled             Boolean              @default(true)
  whatsappEnabled        Boolean              @default(false)
  urgentAlertsImmediate  Boolean              @default(true)
  quietHoursStart        String               @default("20:00")
  quietHoursEnd          String               @default("06:00")
  lastDailySummaryRunAt  DateTime?
  lastWeeklySummaryRunAt DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model TeacherAccountabilitySetting {
  id                                   String   @id @default(cuid())
  attendanceOpenMinutesBeforeLesson    Int      @default(10)
  attendanceGraceMinutesAfterLesson    Int      @default(10)
  attendanceEscalateMinutesAfterLesson Int      @default(30)
  allowEarlyAttendanceMarking          Boolean  @default(true)
  requireLateAttendanceNote            Boolean  @default(true)
  requireAttendanceCorrectionReason    Boolean  @default(true)
  caScorePublishWindowSchoolDays       Int      @default(3)
  caReminderAfterSchoolDays            Int      @default(2)
  caEscalateAfterSchoolDays            Int      @default(4)
  homeworkCheckWindowSchoolDays        Int      @default(2)
  homeworkEscalateAfterSchoolDays      Int      @default(3)
  syllabusUpdateExpectation            String   @default("SAME_DAY")
  teacherCloseoutTime                  String   @default("16:00")
  remindersEnabled                     Boolean  @default(true)
  escalationsEnabled                   Boolean  @default(true)
  correctionApprovalRequired           Boolean  @default(true)
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @updatedAt

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model TeacherObligation {
  id          String                    @id @default(cuid())
  type        TeacherObligationType
  status      TeacherObligationStatus   @default(PENDING)
  priority    TeacherObligationPriority @default(NORMAL)
  sourceModel String
  sourceId    String
  sourceKey   String
  title       String
  description String?
  expectedAt  DateTime
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  reminders   TeacherReminder[]
  escalations TeacherEscalation[]

  @@unique([schoolId, teacherId, sourceKey])
  @@index([schoolId, teacherId, status, expectedAt])
  @@index([schoolId, type, status, expectedAt])
  @@index([schoolId, status, expectedAt])
  @@index([schoolId, sourceModel, sourceId])
}

model TeacherReminder {
  id           String                @id @default(cuid())
  channel      String                @default("IN_APP")
  dedupeKey    String
  message      String
  status       TeacherReminderStatus @default(PENDING)
  scheduledAt  DateTime?
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  obligationId String
  obligation   TeacherObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dedupeKey])
  @@index([schoolId, obligationId, status])
  @@index([schoolId, teacherId, status, scheduledAt])
  @@index([schoolId, status, scheduledAt])
}

model TeacherEscalation {
  id          String                  @id @default(cuid())
  reason      String
  status      TeacherEscalationStatus @default(OPEN)
  escalatedAt DateTime                @default(now())
  resolvedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  obligationId String
  obligation   TeacherObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([schoolId, obligationId])
  @@index([schoolId, teacherId, status, escalatedAt])
  @@index([schoolId, status, escalatedAt])
}

model TeacherCorrectionRequest {
  id          String                         @id @default(cuid())
  sourceModel String
  sourceId    String
  sourceKey   String
  fieldName   String
  oldValue    Json?
  newValue    Json?
  reason      String
  evidenceUrl String?
  status      TeacherCorrectionRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, sourceKey, fieldName])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, teacherId, status, createdAt])
  @@index([schoolId, sourceModel, sourceId])
}

model TeacherAccountabilityAuditLog {
  id          String                           @id @default(cuid())
  action      TeacherAccountabilityAuditAction
  actorId     String?
  actorRole   String?
  sourceModel String
  sourceId    String
  before      Json?
  after       Json?
  message     String?
  createdAt   DateTime                         @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([schoolId, teacherId, createdAt])
  @@index([schoolId, action, createdAt])
  @@index([schoolId, sourceModel, sourceId])
}

model ParentNotificationPreference {
  id                   String                @id @default(cuid())
  dailySummaryEnabled  Boolean               @default(true)
  weeklySummaryEnabled Boolean               @default(true)
  urgentAlertsEnabled  Boolean               @default(true)
  preferredChannel     ParentDeliveryChannel @default(WHATSAPP)
  fallbackChannel      ParentDeliveryChannel @default(SMS)
  emailEnabled         Boolean               @default(true)
  smsEnabled           Boolean               @default(true)
  whatsappEnabled      Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  parentId String @unique
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([schoolId, preferredChannel])
  @@index([schoolId, dailySummaryEnabled])
  @@index([schoolId, weeklySummaryEnabled])
}

model ParentNotification {
  id          String                     @id @default(cuid())
  type        ParentNotificationType
  priority    ParentNotificationPriority @default(NORMAL)
  title       String
  body        String
  href        String?
  payload     Json?
  sourceModel String
  sourceId    String
  sourceKey   String
  occurredAt  DateTime
  readAt      DateTime?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  deliveries ParentNotificationDeliveryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, parentId, sourceKey])
  @@index([schoolId, parentId, readAt, occurredAt])
  @@index([schoolId, parentId, type, occurredAt])
  @@index([schoolId, studentId, occurredAt])
}

model ParentNotificationDeliveryLog {
  id             String                @id @default(cuid())
  channel        ParentDeliveryChannel
  status         ParentDeliveryStatus  @default(PENDING)
  recipient      String?
  provider       String?
  messagePreview String
  errorMessage   String?
  sentAt         DateTime?
  attemptedAt    DateTime              @default(now())
  createdAt      DateTime              @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  notificationId String?
  notification   ParentNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, attemptedAt])
  @@index([schoolId, parentId, attemptedAt])
  @@index([schoolId, channel, attemptedAt])
  @@index([notificationId])
}

model ParentActivityEvent {
  id          String                 @id @default(cuid())
  type        ParentNotificationType
  title       String
  body        String
  href        String?
  payload     Json?
  sourceModel String
  sourceId    String
  sourceKey   String
  occurredAt  DateTime

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([schoolId, parentId, sourceKey])
  @@index([schoolId, parentId, occurredAt])
  @@index([schoolId, studentId, occurredAt])
  @@index([schoolId, teacherId, occurredAt])
}

model Grade {
  id    Int    @id @default(autoincrement())
  level String
  order Int

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  students      Student[]
  classes       Class[]
  syllabi       Syllabus[]
  feeStructures FeeStructure[]

  @@unique([schoolId, level])
  @@unique([schoolId, order])
}

model Class {
  id       Int     @id @default(autoincrement())
  name     String
  capacity Int
  section  String?

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  supervisorId String?
  supervisor   Teacher? @relation("ClassTeacher", fields: [supervisorId], references: [id])

  lessons               Lesson[]
  students              Student[]
  gradeId               Int
  grade                 Grade                   @relation(fields: [gradeId], references: [id])
  events                Event[]
  announcements         Announcement[]
  caBuckets             CABucket[]
  caActivities          CAActivity[]
  continuousAssessments ContinuousAssessment[]
  reportPublications    ReportCardPublication[]
  examEntryWindows      ExamEntryWindow[]
  syllabusTopicProgress SyllabusTopicProgress[]

  @@unique([schoolId, name])
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  teachers Teacher[]
  lessons  Lesson[]

  continuousAssessments ContinuousAssessment[]
  caBuckets             CABucket[]
  caActivities          CAActivity[]
  syllabi               Syllabus[]

  @@unique([schoolId, name])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  exams               Exam[]
  assignments         Assignment[]
  attendances         Attendance[]
  attendanceAuditLogs AttendanceAuditLog[]

  @@index([schoolId, teacherId])
  @@index([schoolId, classId])
  @@index([teacherId, classId, day])
  @@index([schoolId, teacherId, classId, day])
  @@index([schoolId, day])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  startTime DateTime
  endTime   DateTime

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
  results  Result[]

  @@index([schoolId, startTime])
  @@index([schoolId, lessonId])
}

model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])


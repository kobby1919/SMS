// ─── FINANCE MODELS ──────────────────────────────────────────────────────────

// FeeStructure: master template of fees for a grade per term per year.
// Created as DRAFT, items added, then PUBLISHED (locked after publish).
// Bills are generated from a published structure — never from a draft.

model FeeStructure {
  id           Int                @id @default(autoincrement())
  title        String // e.g. "JHS 2 — Term 1 2025/26 Fees"
  description  String?
  academicYear String // e.g. "2025/26"
  term         Term
  status       FeeStructureStatus @default(DRAFT)
  publishedAt  DateTime?
  dueDate      DateTime?

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  gradeId Int
  grade   Grade @relation(fields: [gradeId], references: [id])

  feeItems FeeItem[]
  bills    StudentBill[]

  createdBy String // bursar/admin userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, gradeId, term, academicYear])
  @@index([schoolId, status])
}

// FeeItem: a single fee line inside a FeeStructure.
// isOptional = true means this line is not auto-included for every student
// (e.g. bus fee). Bursar selects optional items per student at bill generation.
// Amount is stored at creation and copied to BillLineItem at bill generation.
// This means changing a FeeItem after bills are generated does NOT affect bills.

model FeeItem {
  id          Int         @id @default(autoincrement())
  name        String // e.g. "Tuition Fee"
  amount      Decimal     @db.Decimal(10, 2)
  category    FeeCategory
  isOptional  Boolean     @default(false)
  description String?

  feeStructureId Int
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  billLineItems BillLineItem[]

  createdAt DateTime @default(now())
}

// StudentBill: one bill per student per fee structure.
// Generated in bulk by bursar (Step 3 — not yet built).
// balance is recomputed and stored every time a payment or discount is applied.
// IMMUTABLE: bills are never deleted. Use status=WAIVED for full exemptions.

model StudentBill {
  id             Int        @id @default(autoincrement())
  totalAmount    Decimal    @db.Decimal(10, 2)
  amountPaid     Decimal    @default(0) @db.Decimal(10, 2)
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)
  balance        Decimal    @db.Decimal(10, 2)
  status         BillStatus @default(UNPAID)
  dueDate        DateTime?
  notes          String?

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  feeStructureId Int
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])

  lineItems      BillLineItem[]
  payments       Payment[]
  discounts      Discount[]
  financeQueries FinanceQuery[]

  generatedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, studentId, feeStructureId])
  @@index([schoolId, status])
  @@index([schoolId, dueDate])
  @@index([schoolId, feeStructureId])
  @@index([schoolId, studentId])
  @@index([schoolId, status, studentId])
  @@index([schoolId, status, feeStructureId])
  @@index([feeStructureId])
}

// BillLineItem: one row per FeeItem on a student's bill.
// Allows tracking partial payment at the line-item level.
// Amount is snapshotted from FeeItem.amount at generation time.

model BillLineItem {
  id         Int     @id @default(autoincrement())
  amount     Decimal @db.Decimal(10, 2)
  amountPaid Decimal @default(0) @db.Decimal(10, 2)
  balance    Decimal @db.Decimal(10, 2)
  isPaid     Boolean @default(false)

  studentBillId Int
  studentBill   StudentBill @relation(fields: [studentBillId], references: [id], onDelete: Cascade)

  feeItemId Int
  feeItem   FeeItem @relation(fields: [feeItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Payment: immutable record of money received.
// Never edited or deleted — reverse with PaymentReversal instead.
// receiptNumber: RCP-{YYYY}-{NNN}, counter resets each calendar year.
// referenceNo: MoMo transaction ID, cheque number, bank ref etc.

model Payment {
  id                Int              @id @default(autoincrement())
  receiptNumber     String
  amount            Decimal          @db.Decimal(10, 2)
  paymentMethod     PaymentMethod
  paymentDate       DateTime         @default(now())
  paidBy            String // name of person who paid
  referenceNo       String?
  externalProvider  PaymentProvider?
  externalReference String?
  idempotencyKey    String?
  notes             String?
  status            PaymentStatus    @default(CONFIRMED)

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  studentBillId Int
  studentBill   StudentBill @relation(fields: [studentBillId], references: [id])

  recordedBy String
  createdAt  DateTime @default(now())

  reversal       PaymentReversal?
  webhookEvents  PaymentWebhookEvent[]
  financeQueries FinanceQuery[]

  @@unique([schoolId, receiptNumber])
  @@unique([schoolId, externalProvider, externalReference])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId, paymentDate])
  @@index([schoolId, status])
  @@index([schoolId, paymentDate, status])
  @@index([schoolId, externalProvider])
  @@index([studentBillId])
}

// PaymentReversal: voids a confirmed payment.
// Sets Payment.status to REVERSED and restores the bill balance.
// Both records kept permanently for audit trail.

model PaymentReversal {
  id         Int      @id @default(autoincrement())
  reason     String
  reversedBy String
  reversedAt DateTime @default(now())

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  paymentId Int     @unique
  payment   Payment @relation(fields: [paymentId], references: [id])

  @@index([schoolId, reversedAt])
}

// Discount: formal fee reduction on a student's bill.
// Use amount for fixed reduction, percentage for proportional.
// Never edit a discount — remove and re-apply if correction needed.

model Discount {
  id           Int            @id @default(autoincrement())
  type         DiscountType
  status       DiscountStatus @default(ACTIVE)
  description  String
  amount       Decimal?       @db.Decimal(10, 2)
  percentage   Decimal?       @db.Decimal(5, 2)
  approvedBy   String
  removedBy    String?
  removeReason String?
  removedAt    DateTime?

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  studentBillId Int
  studentBill   StudentBill @relation(fields: [studentBillId], references: [id])

  createdAt DateTime @default(now())

  @@index([schoolId, status, createdAt])
  @@index([schoolId, studentBillId, status])
}

// ReceiptCounter: tracks the receipt number counter per calendar year.
// One row per year. Application layer atomically reads and increments.
// e.g. { year: 2026, lastCounter: 47 } means next receipt = RCP-2026-048

model ReceiptCounter {
  id          Int @id @default(autoincrement())
  year        Int
  lastCounter Int @default(0)

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, year])
}

// FinanceAuditLog: immutable log of every finance action.
// Written automatically by server actions — UI never writes here directly.
// metadata is a JSON snapshot of the affected record at time of action,
// making the audit self-contained even if records are later modified.

model FinanceAuditLog {
  id          Int         @id @default(autoincrement())
  action      AuditAction
  performedBy String
  entityType  String
  entityId    String
  metadata    Json
  ipAddress   String?
  createdAt   DateTime    @default(now())

  schoolId String @default("default-school")
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([schoolId, action])
}

// ─── WAITLIST ─────────────────────────────────────────────────────────────────
// Standalone — no schoolId, no tenant scoping.
// Collected before any school signs up, so there's nothing to scope to.

// Shared rate-limit state. Tenant/user/IP scope is encoded in the key.
model FinanceQuery {
  id         Int                @id @default(autoincrement())
  reason     FinanceQueryReason
  message    String
  status     FinanceQueryStatus @default(OPEN)
  response   String?
  resolvedAt DateTime?
  resolvedBy String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  parentId String
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  studentBillId Int
  studentBill   StudentBill @relation(fields: [studentBillId], references: [id])

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([schoolId, parentId, createdAt])
  @@index([schoolId, studentBillId, status])
}

model FinanceJob {
  id             String         @id @default(cuid())
  type           FinanceJobType
  status         JobStatus      @default(PENDING)
  payload        Json
  idempotencyKey String?        @unique
  attempts       Int            @default(0)
  maxAttempts    Int            @default(3)
  runAfter       DateTime       @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status, runAfter])
  @@index([type, status])
}

model PaymentWebhookEvent {
  id              String             @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  payload         Json
  signature       String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  lastError       String?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([schoolId, status, receivedAt])
  @@index([provider, status])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model WaitlistEntry {
  id         String         @id @default(cuid())
  name       String
  schoolName String
  email      String         @unique
  role       WaitlistRole
  message    String?
  status     WaitlistStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  schoolId   String?
  createdAt  DateTime       @default(now())

  school School? @relation(fields: [schoolId], references: [id])

  @@index([status, createdAt])
  @@index([createdAt])
}

model SchoolInvite {
  id         String           @id @default(cuid())
  schoolId   String
  email      String
  role       SchoolInviteRole @default(ADMIN)
  tokenHash  String           @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?
  lastSentAt DateTime?
  createdBy  String
  createdAt  DateTime         @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, email])
  @@index([schoolId, revokedAt])
  @@index([expiresAt])
}

model OnboardingAuditLog {
  id          Int                   @id @default(autoincrement())
  schoolId    String?
  waitlistId  String?
  inviteId    String?
  action      OnboardingAuditAction
  performedBy String
  metadata    Json
